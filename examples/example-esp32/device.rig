{
  "rig": "1.3.0",
  "document": {
    "title": "example-esp32",
    "defaultUnit": "px"
  },
  "entities": [
    {
      "id": "lamp",
      "components": {
        "rig.meta.named": { "name": "Status", "stableId": "lamp" },
        "rig.paint.solid": { "rgba": [0.2, 0.55, 1, 1] }
      }
    },
    {
      "id": "espnow",
      "components": {
        "rig.meta.named": { "name": "ESP-NOW", "stableId": "espnow" },
        "rig.io.espnow": {
          "enabled": true,
          "peer": "ff:ff:ff:ff:ff:ff",
          "channel": 1,
          "payload": "hello"
        }
      }
    },
    {
      "id": "panel-lamp",
      "components": {
        "rig.meta.named": { "name": "Status", "stableId": "panel-lamp" },
        "rig.ui.panel": { "role": "device.lamp", "order": 0, "visible": true }
      }
    },
    {
      "id": "ctrl-rgba",
      "components": {
        "rig.meta.named": { "name": "Colour", "stableId": "ctrl-rgba" },
        "rig.ui.control": {
          "panel": "panel-lamp",
          "order": 0,
          "target": "lamp",
          "propertyKey": "rgba",
          "type": "vec4",
          "enabled": true,
          "readOnly": false,
          "widget": "color"
        }
      }
    },
    {
      "id": "panel-espnow",
      "components": {
        "rig.meta.named": { "name": "ESP-NOW", "stableId": "panel-espnow" },
        "rig.ui.panel": { "role": "esp.now", "order": 1, "visible": true }
      }
    },
    {
      "id": "ctrl-enabled",
      "components": {
        "rig.meta.named": { "name": "Enabled", "stableId": "ctrl-enabled" },
        "rig.ui.control": {
          "panel": "panel-espnow",
          "order": 0,
          "target": "espnow",
          "propertyKey": "enabled",
          "type": "bool",
          "enabled": true,
          "readOnly": false,
          "widget": "toggle"
        }
      }
    },
    {
      "id": "ctrl-peer",
      "components": {
        "rig.meta.named": { "name": "Peer", "stableId": "ctrl-peer" },
        "rig.ui.control": {
          "panel": "panel-espnow",
          "order": 1,
          "target": "espnow",
          "propertyKey": "peer",
          "type": "string",
          "enabled": true,
          "readOnly": false,
          "widget": "field"
        }
      }
    },
    {
      "id": "ctrl-channel",
      "components": {
        "rig.meta.named": { "name": "Channel", "stableId": "ctrl-channel" },
        "rig.ui.control": {
          "panel": "panel-espnow",
          "order": 2,
          "target": "espnow",
          "propertyKey": "channel",
          "type": "int",
          "min": 1,
          "max": 14,
          "step": 1,
          "enabled": true,
          "readOnly": false,
          "widget": "field"
        }
      }
    },
    {
      "id": "ctrl-payload",
      "components": {
        "rig.meta.named": { "name": "Payload", "stableId": "ctrl-payload" },
        "rig.ui.control": {
          "panel": "panel-espnow",
          "order": 3,
          "target": "espnow",
          "propertyKey": "payload",
          "type": "string",
          "enabled": true,
          "readOnly": false,
          "widget": "field"
        }
      }
    },
    {
      "id": "act-send",
      "components": {
        "rig.meta.named": { "name": "Send", "stableId": "act-send" },
        "rig.ui.action": {
          "panel": "panel-espnow",
          "order": 4,
          "actionId": "espnow.send",
          "enabled": true
        }
      }
    }
  ]
}
