{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.media.asset_ref.schema.json",
  "title": "rig.media.asset_ref",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "video",
        "model",
        "font",
