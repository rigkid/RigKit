{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.works/schemas/rig.geometry.polygon.schema.json",
  "title": "rig.geometry.polygon",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "$ref": "./_defs.schema.json#/$defs/vec2"
